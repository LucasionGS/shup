# Copy to .env.docker and fill in. Referenced by compose.yaml.
#
# Generate the key with:
#   docker compose run --rm app php artisan key:generate --show

APP_NAME=Shup
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC

# The public URL your reverse proxy serves. Used for generated share links,
# so it must be the external address, not the container's.
APP_URL=https://shup.example.com

# Set to false only if you are serving over plain HTTP on purpose; with TLS at
# the proxy this keeps generated share links on https.
APP_FORCE_HTTPS=true

# The web container runs migrations on start; the queue and scheduler
# containers share the image and must leave this unset.
SHUP_RUN_MIGRATIONS=true

# Host port the reverse proxy should forward to.
SHUP_HTTP_PORT=8080

# Restrict to your proxy's address once you know it; "*" trusts any upstream,
# which is only safe when nothing else can reach the container directly.
TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=shup
DB_USERNAME=shup
DB_PASSWORD=change-me

# The MariaDB container reads these; keep them in step with the DB_* values
# above, which are what the application itself uses.
MARIADB_DATABASE=shup
MARIADB_USER=shup
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Keeping cache, sessions and the queue off the application database avoids the
# write contention that a single shared datastore creates.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# "log" writes invitations and password-reset links to the application log
# instead of sending them, which is a reasonable default until SMTP is set up —
# but the log mailer writes at debug level, so LOG_LEVEL above must be `debug`
# for those messages to appear at all. Set a real mailer before inviting users.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=shup@example.com
MAIL_FROM_NAME="${APP_NAME}"
